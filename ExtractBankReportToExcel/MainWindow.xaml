<Window x:Class="ExtractBankReportToExcel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relevés bancaires vers Excel"
        Height="600"
        Width="1100"
        MinHeight="400"
        MinWidth="760"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Extraction des relevés bancaires"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="FolderPathText"
                       Margin="0,5,0,0"
                       Foreground="DimGray"
                       TextWrapping="Wrap" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
            <Button x:Name="RefreshButton"
                    Content="Actualiser"
                    Padding="14,7"
                    Margin="0,0,8,0"
                    Click="RefreshButton_Click" />
            <Button x:Name="ExportButton"
                    Content="Exporter en Excel (.xlsx)"
                    Padding="14,7"
                    IsEnabled="False"
                    Click="ExportButton_Click" />
        </DockPanel>

        <DataGrid x:Name="OperationsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  ItemsSource="{Binding Operations}"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date opération"
                                    Binding="{Binding OperationDate, StringFormat={}{0:dd/MM/yyyy}}"
                                    Width="130" />
                <DataGridTextColumn Header="Date valeur"
                                    Binding="{Binding ValueDate, StringFormat={}{0:dd/MM/yyyy}}"
                                    Width="130" />
                <DataGridTextColumn Header="Libellé / opération"
                                    Binding="{Binding Description}"
                                    Width="*" />
                <DataGridTextColumn Header="Débit"
                                    Binding="{Binding Debit, StringFormat={}{0:N2}}"
                                    Width="120" />
                <DataGridTextColumn Header="Crédit"
                                    Binding="{Binding Credit, StringFormat={}{0:N2}}"
                                    Width="120" />
                <DataGridTextColumn Header="Fichier PDF"
                                    Binding="{Binding SourceFile}"
                                    Width="220" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   Foreground="DimGray"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
